# ============================================================================
#  Panel Brothers Life — copier ce fichier en .env et remplir les valeurs
#  (sur Railway / un hébergeur : mettre les mêmes variables dans ses réglages)
# ============================================================================

# Port d'écoute (souvent fourni automatiquement par l'hébergeur)
PORT=3000

# --- Lien avec l'API ---------------------------------------------------------
# Adresse de bl-panel-api (sans / final)
API_URL=https://panel-api.webgune.dev
# Clé partagée : EXACTEMENT la même valeur que PANEL_API_KEY dans le .env de l'API
PANEL_API_KEY=une-longue-chaine-aleatoire

# --- Connexion Discord ---------------------------------------------------------
# 1. https://discord.com/developers/applications → New Application
# 2. Onglet OAuth2 : copier Client ID et Client Secret ci-dessous
# 3. OAuth2 → Redirects : ajouter EXACTEMENT la valeur de DISCORD_REDIRECT_URI
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_REDIRECT_URI=https://panel-front.webgune.dev/auth/discord/callback

# Webmasters : ID Discord (mode développeur → clic droit sur le profil → Copier
# l'identifiant). Tous les droits + page « Accès ». Séparés par des virgules.
WEBMASTER_DISCORD_IDS=111111111111111111,222222222222222222

# Secret de signature des sessions (longue chaîne aléatoire). Le changer déconnecte tout le monde.
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Durée de connexion en jours
SESSION_DAYS=7

# Qui peut envoyer des annonces en jeu : webmaster (défaut) ou staff (toute personne connectée)
ANNOUNCE_ALLOWED=webmaster

# --- Accès automatique par rôle Discord (facultatif) -------------------------
# Les membres de ce serveur Discord qui ont UN des rôles listés entrent sans être
# ajoutés à la main. Avec un serveur mais sans rôle : tous ses membres.
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=
